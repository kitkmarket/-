<Window x:Class="LosyandexBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лосяндекс Браузер" Width="1280" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#B8CBE0">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="9,4"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#17314F"/>
            <Setter Property="Background" Value="#F5FAFF"/><Setter Property="BorderBrush" Value="#7295B8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#385B82" BorderBrush="#183552" BorderThickness="0,0,0,2" Padding="7">
            <DockPanel>
                <TextBlock Text="Лосяндекс Браузер" Foreground="White" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="3,0,16,0"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="＋ Вкладка" Click="NewTab_Click" ToolTip="Новая вкладка"/>
                    <Button Content="★" Click="Bookmark_Click" ToolTip="Добавить в закладки"/>
                    <Button Content="🔑" Click="Passwords_Click" ToolTip="Сохранённые пароли"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="◀" Click="GoBack_Click" ToolTip="Назад"/>
                    <Button Content="▶" Click="GoForward_Click" ToolTip="Вперёд"/>
                    <Button Content="↻" Click="Reload_Click" ToolTip="Обновить"/>
                    <Button Content="⌂" Click="Home_Click" ToolTip="Домой"/>
                    <TextBox x:Name="AddressBar" Width="650" Height="31" VerticalContentAlignment="Center" FontSize="14" Padding="8,2" KeyDown="AddressBar_KeyDown" Text="https://losyandex.lovable.app/"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#D8E7F5" BorderBrush="#829DB8" BorderThickness="0,1,0,0" Padding="6,3">
            <TextBlock x:Name="StatusText" Text="Готово" Foreground="#28415F"/>
        </Border>
        <TabControl x:Name="BrowserTabs" Background="#B8CBE0" BorderBrush="#6686A5" FontSize="13"/>
    </DockPanel>
</Window>
